# Application Insights 연결 문자열
APPLICATION_INSIGHTS_CONNECTION_STRING=

# API 보안 키 (프로덕션에서 필수)
# 설정하지 않으면 API 키 검증이 비활성화됩니다 (개발 환경용)
API_KEY=

# OpenAI API 키 (Agent 기능 사용 시 필요)
OPENAI_API_KEY=

# CORS 허용 도메인 (콤마로 구분)
# 예: CORS_ORIGINS=https://example.com,https://api.example.com
CORS_ORIGINS=

# 데이터 디렉토리 경로 (Docker 환경에서 필수)
DATA_DIR=
